# Where the search microservice lives. The ONLY variable this app needs.
#
# Must be reachable from Vercel's servers, which means a public hostname over HTTPS —
# not localhost, and not a private address. The compose file binds to 127.0.0.1 by
# default, so put the service behind a reverse proxy with TLS before pointing this at it.
#
# Local development against a container on your own machine:
#   SEARCH_SERVICE_URL=http://127.0.0.1:8000
SEARCH_SERVICE_URL=https://search.internal.example.com

# NOTE: there is deliberately no admin key here.
#
# The admin key is entered at sign-in and held in an httpOnly cookie for that session
# only, so this deployment stores no credential that can mint API tokens. Putting one in
# a Vercel environment variable would mean anyone with project access — or a build log
# that echoed it — could issue tokens against your service.

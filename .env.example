# Copy to .env and adjust. Every value here is a default from app/config.py —
# comment a line out to accept the default.
#
# IMPORTANT: comments go on their own line, never at the end of a setting.
# `python-dotenv` parses `KEY=            # note` as the *value* `# note`, not as
# empty. That silently enabled the paid Firecrawl tier once already, so keep
# every comment above the line it describes.

# ------------------------------------------------------------------- service
# dev | staging | prod
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true

# ---------------------------------------------------------------------- auth
# Off in dev. With ENVIRONMENT=prod and AUTH_ENABLED=true, the app refuses to
# boot unless SERVICE_API_KEYS is non-empty.
AUTH_ENABLED=false
# Comma-separated, one key per consuming app.
SERVICE_API_KEYS=

# Budget of cost units per minute, per API key — not a flat request count.
# /search costs 1, /extract 3, /search_and_extract 4, /research 10.
# Counters live in Redis so the budget is shared across replicas.
# With AUTH_ENABLED=false every caller is "anonymous", so this becomes one
# global budget rather than a per-consumer one.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# -------------------------------------------------------------------- search
#
# Both providers are paid — there is no free retrieval path. The cache is
# therefore the whole cost story for search: every miss is a billed call.
#
# REQUIRED. The primary provider: Google's index via Serper, ~$1/1k at the $50
# entry pack, down to ~$0.30/1k at volume. 2,500 credits free to trial.
# Note credits are prepaid and EXPIRE SIX MONTHS after purchase, so buying far
# ahead of measured volume loses money rather than saving it.
SERPER_API_KEY=
SERPER_ENDPOINT=https://google.serper.dev/search
# Google `gl` country code. Changes which regional index answers, so it affects
# result quality more than it looks.
SERPER_COUNTRY=us

# Optional fallback, and blank disables it entirely. ~$5/1k — about 5x Serper —
# but it is an independent index rather than another Google reseller, so it fails
# differently than the primary. It only fires when Serper errors or under-returns,
# which normally fits inside Brave's $5/month free credit.
BRAVE_API_KEY=

# Serper bills one credit for up to 10 results and two above that, so 10 is the
# free ceiling — asking for fewer costs exactly the same.
DEFAULT_RESULT_COUNT=10
MAX_RESULT_COUNT=20
# Fewer results than this from the primary triggers the fallback provider. Each
# handoff is a SECOND paid call, so keep this low enough that it fires only on a
# near-empty response.
MIN_ACCEPTABLE_RESULTS=3

# Hosts dropped from every search result, CSV, subdomains included. Empty string
# disables filtering entirely; a caller can override per request with
# `exclude_domains` (send [] for none).
#
# The default is NOT an editorial choice about social media — it is the set of
# hosts the extractor provably cannot read. Measured: reddit/facebook are
# robots-disallowed (0 chars), instagram yields 145-491 chars of caption, and a
# youtube watch page yields 3k-106k chars of navigation furniture that reads as
# article text to anything downstream. Leaving them in costs a result slot and
# sometimes a PAID extraction to return nothing usable.
#
# On Serper these become Google `-site:` operators, so excluded hosts never take
# a slot and the results behind them move up — filtering does not shrink the set.
SEARCH_BLOCKED_DOMAINS=youtube.com,youtu.be,instagram.com,facebook.com,reddit.com,x.com,twitter.com,tiktok.com,pinterest.com,threads.net,threads.com,snapchat.com
SEARCH_TIMEOUT_S=8.0

# -------------------------------------------------------------------- social
# POST /social_search — Twitter/Reddit, a distinct capability from /search
# above, not affected by SEARCH_BLOCKED_DOMAINS (those two hosts are blocked
# THERE because the extraction ladder can't read them; this endpoint never
# extracts, it calls a dedicated platform API directly).
#
# Deliberately NOT Apify. Apify's per-item store pricing looks cheap but this
# org's real production bill for existing, unrelated Apify usage runs to
# ~$1,000/month once platform/compute/storage overhead is counted — the exact
# "headline price isn't the real price" trap this whole file already guards
# against for search/extraction. Both of these are flat pay-per-call resellers
# with no subscription and no platform-rental fee.
#
# Blank disables Twitter search entirely. ~$0.15/1k tweets, pay-as-you-go, no
# minimum spend, credits never expire.
#
# CONFIDENCE NOTE: the endpoint path below is an unverified best-effort guess —
# see app/search/twitter_api.py's module docstring before deploying this.
# Confirm against a real API key and twitterapi.io's own reference first.
TWITTERAPI_API_KEY=
TWITTERAPI_ENDPOINT=https://api.twitterapi.io/twitter/tweet/advanced_search

# Blank disables Reddit search entirely. $0.002/call flat, no subscription, no
# minimum, self-serve (no approval wait, unlike Reddit's own official API).
# This one WAS fetched and confirmed directly against the provider's own
# OpenAPI spec — see app/search/reddit_api.py.
REDDITAPIS_API_KEY=
REDDITAPIS_ENDPOINT=https://api.redditapis.com/api/reddit/search

# ---------------------------------------------------------------- extraction
# The ladder is trafilatura -> http_retry -> firecrawl. Two free HTTP tiers, then
# a managed scraper that renders from its own egress IP.
#
# There is no local-browser tier and no setting to add one. A headless-Chromium
# tier existed and was deleted: its measured wins were `blocked` rescues rather
# than `empty` ones, and beating a bot wall is a property of the egress address
# rather than the renderer — so those wins erode on a datacenter IP exactly where
# they would be needed. Firecrawl scrapes from its own address, so blocking
# converts into cost instead of failure.
#
# Blank disables the paid extraction fallback. THIS ONE COSTS MONEY PER PAGE —
# and it is the only tier that can render JS or beat a bot wall, so leaving it
# blank means those pages come back `empty`/`blocked` rather than slower.
FIRECRAWL_API_KEY=

# Shared by both free tiers — they are plain HTTP GETs.
PAGE_TIMEOUT_S=15.0
# The paid tier's own budget. Keep it well under EXTRACT_DEADLINE_S: the router
# refuses to START a billable scrape it cannot finish before the batch deadline,
# so a value too close to the deadline silently disables the paid tier instead of
# making it slower. Measured full-ladder times on pages that reach it: 3.6-12.5s.
FIRECRAWL_TIMEOUT_S=15.0
# 4MB cap per response body.
MAX_HTML_BYTES=4194304
# Extractions shorter than this escalate to the next tier.
MIN_EXTRACT_CHARS=250

# How many of a result set get crawled when the caller doesn't pass
# `extract_top_k`. Search returns DEFAULT_RESULT_COUNT ranked results and only the
# top K are paid for — the deployment's cost ceiling, not each caller's. Crawling
# all ten costs twice what five does and adds the slowest page to every request.
# 0 means extract nothing by default.
DEFAULT_EXTRACT_TOP_K=5

# Extraction tier ceiling when a caller doesn't pass max_tier.
#
# Safe as shipped: the paid tier is gated behind FIRECRAWL_API_KEY, so with no key
# this cannot cause spend. With a key, an omitted max_tier means "use the full
# ladder I'm paying for".
#
# Measured on pages weighted to defeat the free tiers:
#   http_retry   4/8 extracted, 0 billed     firecrawl   8/8 extracted, 4 billed
#
# `http_retry` is the only other meaningful value: it is the free-only ceiling, and
# a legitimate configuration rather than a degraded one — it just means blocked and
# JS-dependent pages come back unextracted instead of costing ~$0.00083 each.
DEFAULT_MAX_TIER=firecrawl

# Total budget for a combined endpoint's extraction fan-out, bounding the
# ENDPOINT's latency rather than any single page. Pages that miss it degrade to
# snippet-only. Derived from the per-page timeouts this was 40s and measured p95
# on /search_and_extract hit 43s — snippets now beat markdown later.
# Must stay clear of FIRECRAWL_TIMEOUT_S by enough for the free tiers to run
# first (~10s of headroom here); otherwise escalation to the paid tier is
# budget-gated away on every page and extraction quietly gets worse.
EXTRACT_DEADLINE_S=25.0

# The same bound for /extract, which takes up to 20 caller-supplied URLs — four
# waves at EXTRACT_CONCURRENCY=5, against the pipeline's single wave of 5. Reusing
# the 25s figure above would time out most of a full batch.
EXTRACT_BATCH_DEADLINE_S=60.0

# Process-wide outbound page fetch ceiling.
MAX_CONCURRENCY=10
# Per-request fan-out ceiling.
EXTRACT_CONCURRENCY=5

RESPECT_ROBOTS_TXT=true

# Rotate over a pool of current, real browser User-Agents. A single fixed UA
# across thousands of requests is an easy crawler fingerprint to block.
ROTATE_USER_AGENTS=true

# Politeness, per origin. Hammering one host is the fastest way to earn the 403
# that pushes a page down the expensive tier ladder. In-process, so with N
# replicas the effective per-host limit is N x this value.
PER_HOST_CONCURRENCY=2
# Minimum gap between request starts to the same origin. Do not set this to 0:
# the escalation ladder hits one origin up to four times within seconds, which is
# how you earn the block that pushes pages onto the PAID tier. Measured from a
# residential IP, realpython.com went from a clean 43,698-char extraction to a
# Cloudflare JS challenge on the next request. Costs an escalated page up to
# +1.5s and costs nothing when a request's pages are on different origins.
PER_HOST_DELAY_S=0.5

# Optional upstream proxy for extraction fetches only — search API traffic never
# goes through it, since those providers authenticate our key and have no reason
# to block us. Residential providers expose a single rotating endpoint, so one URL
# is enough. This is the lever that keeps blocked *pages* reachable.
PROXY_URL=
PROXY_FOR_EXTRACTION=true

# --------------------------------------------------------------------- cache
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true
# Bump to invalidate every cached entry at once.
CACHE_VERSION=v1
# Stopword-strip and token-sort query keys. Higher hit rate, but merges queries
# that differ only in word order.
CACHE_AGGRESSIVE_QUERY_KEY=true

# 1h — general queries.
CACHE_TTL_SEARCH=3600
# 5m — freshness-constrained queries.
CACHE_TTL_SEARCH_FRESH=300
# 2m — rescued partial results, kept short so one bad upstream minute isn't
# served for an hour.
CACHE_TTL_SEARCH_DEGRADED=120
# 24h — extracted page content.
CACHE_TTL_PAGE=86400
# 30m — negative cache. Stops known-bad URLs from re-paying the whole tier
# ladder (including the paid tier) on every request.
CACHE_TTL_FAILURE=1800

CACHE_COMPRESS_MIN_BYTES=1024
CACHE_COMPRESS_LEVEL=3
# In-process L1 entries.
LOCAL_CACHE_SIZE=512
LOCAL_CACHE_TTL_S=60

SINGLEFLIGHT_LOCK_TTL_S=30
SINGLEFLIGHT_WAIT_S=10.0

# --------------------------------------------------------------- reliability
# Total tries, not extra ones: 1 disables retrying. Only failures marked
# retryable are retried — a bad API key is never worth a second attempt.
RETRY_ATTEMPTS=2
RETRY_BACKOFF_S=0.3
CIRCUIT_FAIL_THRESHOLD=5
CIRCUIT_RESET_AFTER_S=60.0

# ------------------------------------------------------------------- budget
# Real-dollar spend ceiling across EVERY billable call this service makes —
# search, extraction, and social combined. Fails CLOSED, deliberately, unlike
# everything else in this file — see app/common/budget.py's module docstring
# for why. 0 disables a given window.
#
# $30/day is HALF of a $50/day total target for "the Threads routine" end to
# end. The other $20/day is the sibling es-mcp project's own Threads-specific
# daily cap (MCP_SERVICE_DAILY_BUDGET_USD there) for its Athena/S3 path.
# $20 + $30 = $50/day, enforced by two independent budgets in two services —
# raise this only alongside a matching decision about who else's traffic is
# now sharing it, since it is server-wide, not per-caller, until this service
# has a second real consumer.
BUDGET_DAILY_USD=30
BUDGET_MONTHLY_USD=700

# ----------------------------------------------------------------- llm layer
# Strictly opt-in. Never invoked by /search or /extract, and /research returns
# 503 rather than spending anything while this is false.
ENABLE_LLM_LAYER=false
# anthropic | ollama
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Blank = the first-party Anthropic API. Set to an Anthropic-compatible gateway
# to route through it — e.g. https://ai-gateway.vercel.sh for Vercel AI Gateway,
# where the key is your `vck_...` gateway key rather than an `sk-ant-...` one.
#
# Named LLM_BASE_URL, not ANTHROPIC_BASE_URL, on purpose: the Anthropic SDK and
# Claude Code both read that name from the process environment, and OS env
# outranks .env — so on a machine with it exported, a setting by that name here
# would be silently ignored and a gateway key sent to api.anthropic.com.
LLM_BASE_URL=

# LLM_MODEL must match whichever endpoint LLM_BASE_URL points at.
# Gateways namespace by provider and spell the version differently:
#   first-party      claude-haiku-4-5
#   Vercel gateway   anthropic/claude-haiku-4.5     <- note the dot
# `effort` is not supported on the Haiku tier — depth is LLM_MAX_TOKENS and
# prompt design.
LLM_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=60.0
# The main /research cost lever. Extracted pages run 40k+ chars; ten unclipped
# sources would be a six-figure-token prompt.
LLM_MAX_SOURCE_CHARS=6000

# Only read when LLM_PROVIDER=ollama. Ignored entirely on the default
# (anthropic) path — see PROGRESS.md for why this alternative exists.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --------------------------------------------------------------- benchmarking
# Read only by scripts/verify/benchmark.py --compare-tavily. Not a service
# setting — the app never calls Tavily.
TAVILY_API_KEY=

# ------------------------------------------------------------------- runtime
# uvicorn workers; scale with container replicas instead.
WEB_CONCURRENCY=1

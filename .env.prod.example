# Production .env template.
#
# Copy to `.env` ON THE SERVER, fill in the credentials, and chmod 600. Do not commit
# it and do not bake it into the image — the Dockerfile deliberately never COPYs it.
#
# Only the values marked CHANGE differ from the development defaults. Everything else
# is documented in .env.example; this file is the deployment delta.

# ============================================================== CHANGE: identity
# Disables /docs, and makes _validate_startup enforce the auth rules below.
ENVIRONMENT=prod

# ============================================================== CHANGE: security
# With auth off, EVERY caller shares one "anonymous" identity, which means your
# 120/min budget becomes a single global budget for the whole internet and anyone
# who can reach the host can spend your Serper and Firecrawl credits.
#
# Note the startup guard only *warns* if you set ENVIRONMENT=prod and leave this
# false — it refuses to boot only when auth is ON with no keys. Setting both is on
# you.
AUTH_ENABLED=true

# Admin / break-glass keys, comma separated, no spaces. These are what the token
# admin UI signs in with, and what keeps working if Redis is down. Per-app tokens
# are issued at runtime through the UI and live in Redis — they do NOT go here.
#
# Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Keep this list short. One key for the admin UI plus one sealed break-glass key is
# the sane shape.
SERVICE_API_KEYS=

# Per-token budget in cost units per minute. /search is 1 unit, /research is 10.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# =============================================================== CHANGE: caching
# Container-network hostname. The compose file also sets this, so the same .env
# works locally, but being explicit here avoids a surprise if that changes.
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true

# ============================================================= search providers
# Primary. ~$1/1k, Google-backed. Credits are PREPAID and expire six months after
# purchase, so the service can start 401ing with no config change when a balance
# runs out — watch wss_search_credits_total.
SERPER_API_KEY=

# Independent-index fallback, ~$5/1k. Fires only when Serper errors or under-returns.
# Blank disables it, which costs you resilience rather than money.
BRAVE_API_KEY=

# ================================================================== extraction
# THIS ONE COSTS MONEY PER PAGE. Blank disables the paid tier entirely, which means
# blocked and JS-dependent pages come back unextracted instead of billed — a real
# configuration, not a degraded one.
FIRECRAWL_API_KEY=

# Expect the paid share to RISE after this deploy. Datacenter IPs are scored worse
# than residential ones by anti-bot systems, and blocked pages fall through to the
# paid scraper by design. Baseline is 33%; watch
# wss_extract_rescues_total{prior_status="blocked"} against it.

# ================================================================== llm layer
# /research returns 503 unless this is true AND a provider is configured, so a
# default deployment cannot be billed by it.
ENABLE_LLM_LAYER=false
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Blank = first-party API. NOT named ANTHROPIC_BASE_URL on purpose: the Anthropic
# SDK reads that name from the process environment and OS env outranks .env, so an
# exported value would silently send this key to api.anthropic.com.
LLM_BASE_URL=
# Must match the endpoint above. First-party is `claude-haiku-4-5`; the Vercel
# gateway spells the same model `anthropic/claude-haiku-4.5`.
LLM_MODEL=claude-haiku-4-5

# ==================================================================== runtime
# One uvicorn worker per container keeps the Prometheus counters correct. Scale with
# container replicas via docker-compose.scale.yml, not with workers.
WEB_CONCURRENCY=1

# =================================================================== optional
# Leave blank. Set only if extraction blocking gets materially worse than the 33%
# baseline after the move — and note it has never been tested against a real proxy.
PROXY_URL=
PROXY_FOR_EXTRACTION=true
